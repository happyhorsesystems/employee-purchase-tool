generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model EmployeePurchaseSettings {
  id                     Int      @id @default(1)
  employeeMarkupPercent  Float    @default(15)
  consignmentCostPercent Float    @default(50)
  reservationDays        Int      @default(30)
  notePrefix             String   @default("Employee Purchase")
  invoiceSubject         String   @default("Employee Purchase Invoice")
  updatedAt              DateTime @updatedAt
}

model EmployeePurchaseAuditLog {
  id                     Int      @id @default(autoincrement())
  shop                   String
  draftOrderId           String
  actionStatus           String
  message                String?
  employeeMarkupPercent  Float?
  consignmentCostPercent Float?
  invoiceSent            Boolean  @default(false)
  pricingApplied         Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@index([shop, draftOrderId])
  @@index([createdAt])
}